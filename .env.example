# Copy this file to .env, then choose a long, unique private key.
# Use at least 10 characters; a short phrase of several words is best.
GIFT_ACCESS_KEY=replace-with-a-long-private-phrase

# Port for the gift server (default 4174).
PORT=4174

# Optional bind address (default 0.0.0.0).
# HOST=0.0.0.0

# Persistent folder for the gift text, photos, soundtrack, and session secret.
# Point this at a persistent disk when deploying to a hosting platform.
GIFT_DATA_DIR=./server/data

# If the site runs behind an HTTPS reverse proxy (Render, Fly.io, nginx, etc.),
# uncomment these so secure cookies and client IP rate limiting work correctly.
# GIFT_TRUST_PROXY=1
# GIFT_COOKIE_SECURE=1
