# ---------------------------------------------------------------------------
# Shared cloud storage (recommended when the gift will open on another device)
# ---------------------------------------------------------------------------
# Create a Supabase project, run supabase/schema.sql, and create one confirmed
# Auth user. That user's email goes here; its PASSWORD is the gift key.
# The anon/publishable key is safe in the browser. NEVER use a service-role key.
#
# The password itself is not stored in this file. Both people enter it at the
# gift gate, so edits, photos, and the soundtrack appear on every device.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_GIFT_EMAIL=

# ---------------------------------------------------------------------------
# Optional self-hosted Node server (used only when Supabase is not configured)
# ---------------------------------------------------------------------------
# Copy this file to .env, then choose a long, unique private key.
# Use at least 10 characters; a short phrase of several words is best.
GIFT_ACCESS_KEY=replace-with-a-long-private-phrase

# Port for the gift server (default 4174).
PORT=4174

# Optional bind address (default 0.0.0.0).
# HOST=0.0.0.0

# Persistent folder for the gift text, photos, soundtrack, and session secret.
# Point this at a persistent disk when deploying to a hosting platform.
GIFT_DATA_DIR=./server/data

# If the site runs behind an HTTPS reverse proxy (Render, Fly.io, nginx, etc.),
# uncomment these so secure cookies and client IP rate limiting work correctly.
# GIFT_TRUST_PROXY=1
# GIFT_COOKIE_SECURE=1
